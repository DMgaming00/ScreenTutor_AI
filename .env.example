# ScreenTutor AI — Environment Configuration
# Copy to .env and fill in values as needed

# Orchestrator Configuration
ORCHESTRATOR_PORT=4317
NODE_ENV=development

# AI Sponsor
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Redis Sponsor
REDIS_URL=redis://localhost:6379
MEMORY_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
TUTOR_CACHE_TTL_SECONDS=1800
RESEARCH_CACHE_TTL_SECONDS=3600

# Browserbase Sponsor
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_ENABLED=false

# Simular Sponsor
SIMULAR_API_KEY=
SIMULAR_ENABLED=false
ENABLE_SAFE_ACTIONS=false

# Fetch AI / Agentverse Sponsor
FETCH_AGENTVERSE_API_KEY=
FETCH_AGENTVERSE_AGENT_ADDRESS=
FETCH_AGENTVERSE_ENABLED=false

# Arize / Phoenix Sponsor
ARIZE_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=
ARIZE_ENABLED=false

# Sentry Sponsor
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=false

# Cartesia voice (Sonic streaming TTS + Ink streaming STT)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_ENABLED=true
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_STT_MODEL=ink-2

# App Debug & Preferences
SCREENSHOT_STORAGE=none
PRIVACY_MODE_DEFAULT=true
DEBUG_COORDINATES=true
